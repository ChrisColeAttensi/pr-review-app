# Generated by scripts/release.sh from packaging/pr-bar.rb.template. Do not edit by hand.
token = ENV.fetch("HOMEBREW_GITHUB_API_TOKEN") { `#{HOMEBREW_PREFIX}/bin/gh auth token 2>/dev/null`.strip }

cask "pr-bar" do
  version "__VERSION__"
  sha256 "__SHA256__"

  # Private release asset on the tap repo: the GitHub API serves it to an authenticated request,
  # so installing needs read access to the tap only, not to the app's source.
  # Uses HOMEBREW_GITHUB_API_TOKEN if set, otherwise the token `gh` is logged in with.
  url "https://api.github.com/repos/ChrisColeAttensi/homebrew-tap/releases/assets/__ASSET_ID__",
      header: [
        "Accept: application/octet-stream",
        "Authorization: Bearer #{token}",
      ]
  name "PR Bar"
  desc "Menu bar monitor for your GitHub pull requests"
  homepage "https://github.com/ChrisColeAttensi/homebrew-tap"

  depends_on arch: :arm64
  depends_on :macos

  app "PR Bar.app"

  # Not signed with a Developer ID: drop the download quarantine so Gatekeeper lets it open.
  postflight_steps do
    run "/usr/bin/xattr", args: ["-dr", "com.apple.quarantine", "{{appdir}}/PR Bar.app"], must_succeed: false
  end

  # Quit the running copy before an upgrade replaces it.
  uninstall quit: "com.chriscole.prbar"

  # Settings and PR data are shared with PR Review, so zapping PR Bar leaves them alone.
  zap trash: [
    "~/Library/LaunchAgents/PR Bar.plist",
  ]
end
